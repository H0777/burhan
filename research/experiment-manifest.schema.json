{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExperimentManifest",
  "type": "object",
  "description": "Validation schema for Track A empirical experiment run manifests (R17 regime: strict temporal/participant-disjoint splits; R18 regime: outcome computed by the fail-able evaluation gate as PASSED/FAILED or INSUFFICIENT_DATA, with the generated claim, gate decision and evaluation seal recorded — never a constant SUPPORTED string).",
  "required": [
    "experiment_id",
    "protocol_version",
    "dataset_hash",
    "split_hash",
    "code_revision",
    "config_hash",
    "config_path",
    "seed",
    "policy_version",
    "engine_version",
    "outcome",
    "environment",
    "created_at",
    "dataset_nature",
    "identifier_source",
    "dataset_size",
    "split_manifest"
  ],
  "properties": {
    "experiment_id": {
      "type": "string",
      "pattern": "^EXP-[A-Z0-9_-]+$"
    },
    "protocol_version": { "type": "string" },
    "dataset_hash": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "split_hash": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$",
      "description": "manifest_hash of the accepted (or rejected, for INSUFFICIENT_DATA runs) split-manifest.json"
    },
    "code_revision": { "type": "string" },
    "config_hash": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "config_path": { "type": "string" },
    "protocol_path": {
      "type": "string",
      "description": "Name of the resolved protocol document when the config was loaded through the experiment-config shim"
    },
    "seed": { "type": "integer" },
    "policy_version": { "type": "string" },
    "engine_version": { "type": "string" },
    "outcome": {
      "enum": ["PASSED", "FAILED", "INSUFFICIENT_DATA"],
      "description": "R18 research status computed by evaluate_gate (PASSED replaces the retired SUPPORTED constant)"
    },
    "model_id": {
      "type": "string",
      "description": "Identifier of the evaluated model configuration (required for PASSED/FAILED runs)"
    },
    "model_artifact_path": {
      "type": "string",
      "description": "Repo-relative path where the runner wrote the evaluated model artifact (required for PASSED/FAILED runs)"
    },
    "gate_decision": {
      "type": "object",
      "description": "The R18 gate decision as produced (required for PASSED/FAILED runs)",
      "required": ["research_status", "activation_allowed", "reasons", "claim"],
      "properties": {
        "research_status": { "enum": ["PASSED", "FAILED", "INSUFFICIENT_DATA"] },
        "activation_allowed": { "type": "boolean" },
        "reasons": {
          "type": "array",
          "items": { "type": "string" }
        },
        "claim": {
          "type": "string",
          "description": "Claim text GENERATED from the decision — never a constant SUPPORTED string"
        }
      },
      "additionalProperties": false
    },
    "evaluation_seal": {
      "type": "object",
      "description": "Seal over the exact evaluated labels/predictions, the frozen config, split and model artifact, and the evaluation time (required for PASSED/FAILED runs); reopening with changed thresholds requires a NEW run",
      "required": [
        "schema_version",
        "run_id",
        "labels_sha256",
        "predictions_sha256",
        "config_hash",
        "split_hash",
        "model_hash",
        "evaluated_at",
        "seal_hash"
      ],
      "properties": {
        "schema_version": { "type": "string" },
        "run_id": { "type": "string" },
        "labels_sha256": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
        "predictions_sha256": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
        "config_hash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
        "split_hash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
        "model_hash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
        "evaluated_at": { "type": "string" },
        "seal_hash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "description": "ACTUAL runtime/library versions — recorded, never hardcoded",
      "required": ["python_version", "python_implementation", "numpy_version", "scikit_learn_version", "joblib_version", "os", "platform_machine"],
      "properties": {
        "python_version": { "type": "string" },
        "python_implementation": { "type": "string" },
        "numpy_version": { "type": "string" },
        "scikit_learn_version": { "type": "string" },
        "joblib_version": { "type": "string" },
        "os": { "type": "string" },
        "platform_machine": { "type": "string" }
      },
      "additionalProperties": false
    },
    "created_at": { "type": "string" },
    "dataset_nature": {
      "enum": ["synthetic", "institutional"]
    },
    "identifier_source": { "type": "string" },
    "dataset_size": {
      "type": "object",
      "required": ["requested", "generated"],
      "properties": {
        "requested": { "type": "integer", "minimum": 0 },
        "generated": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "max_records": { "type": ["integer", "null"] },
    "split_manifest": {
      "type": "object",
      "required": ["manifest_hash", "accepted", "record_counts", "drop_summary"],
      "properties": {
        "manifest_hash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
        "accepted": { "type": "boolean" },
        "record_counts": {
          "type": "object",
          "required": ["train", "validation", "test"],
          "properties": {
            "train": { "type": "integer", "minimum": 0 },
            "validation": { "type": "integer", "minimum": 0 },
            "test": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "drop_summary": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      },
      "additionalProperties": false
    },
    "insufficient_data": {
      "type": "object",
      "description": "Present only when outcome is INSUFFICIENT_DATA",
      "required": ["reason", "split_sizes", "drop_summary"],
      "properties": {
        "reason": { "type": "string" },
        "split_sizes": {
          "type": "object",
          "required": ["train", "validation", "test"],
          "properties": {
            "train": { "type": "integer", "minimum": 0 },
            "validation": { "type": "integer", "minimum": 0 },
            "test": { "type": "integer", "minimum": 0 }
          }
        },
        "drop_summary": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "validation_errors": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "metrics": {
      "type": "object",
      "required": ["precision", "recall", "f1_score", "pr_auc", "fpr_per_1000"],
      "properties": {
        "precision": { "type": "number", "minimum": 0, "maximum": 1 },
        "recall": { "type": "number", "minimum": 0, "maximum": 1 },
        "f1_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "pr_auc": { "type": "number", "minimum": 0, "maximum": 1 },
        "fpr_per_1000": { "type": "number", "minimum": 0 }
      }
    },
    "metrics_by_model": { "type": "object" },
    "model_hash": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    }
  },
  "if": {
    "properties": { "outcome": { "const": "INSUFFICIENT_DATA" } }
  },
  "then": {
    "not": { "required": ["metrics", "model_hash"] }
  },
  "else": {
    "required": [
      "metrics",
      "model_hash",
      "model_id",
      "model_artifact_path",
      "gate_decision",
      "evaluation_seal"
    ]
  },
  "additionalProperties": false
}
