{
  "realm": "burhan",
  "displayName": "Burhan AML Audit Chain (staging)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "verifyEmail": false,
  "rememberMe": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "accessTokenLifespan": 900,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "clients": [
    {
      "clientId": "iraq-aml-frontend",
      "name": "Burhan institutional frontend (public, PKCE)",
      "description": "Authorization Code + PKCE only: no client_secret, no password grant, no implicit flow (spec section 8).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "surrogateAuthRequired": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "http://127.0.0.1:18080/auth/callback"
      ],
      "webOrigins": [
        "http://127.0.0.1:18080"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://127.0.0.1:18080"
      },
      "protocolMappers": [
        {
          "name": "audience: iraq-aml-audit-engine",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "iraq-aml-audit-engine",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "nbf (institutional R10 mandatory claim)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "nbf",
            "claim.value": "1793232000",
            "jsonType.label": "long",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "institution_id (staging tenant routing claim)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "institution_id",
            "claim.value": "INST-CENTRAL-STAGING",
            "jsonType.label": "String",
            "multivalued": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}
