# infra/staging/.env.example (H04)
#
# Copy to infra/staging/.env (gitignored — the root .gitignore already excludes
# .env / .env.*) and fill REAL generated values. Generate secrets, never invent:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
#   node -e "console.log('0x'+require('crypto').randomBytes(32).toString('hex'))"
#
# Nothing in this file is committed with real values. The staging compose fails
# fast when a required variable is missing.

# --- PostgreSQL (bootstrap superuser + the two least-privilege roles) --------
# Superuser of the staging cluster (postgres image bootstrap).
STAGING_PG_SUPERUSER_PASSWORD=
# ira_aml_migrator — migration/owner role (runs alembic; NOSUPERUSER NOBYPASSRLS).
STAGING_MIGRATOR_PASSWORD=
# ira_aml_app — application role (engine + workers; NOSUPERUSER NOBYPASSRLS).
STAGING_APP_PASSWORD=

# --- Anchor signer secret (H04 staging) --------------------------------------
# Private key of the anchoring signer, generated TEMPORARILY for staging,
# funded by the anchor-funder one-shot service. Lives only in this gitignored
# file; rotate per environment.
STAGING_ANCHOR_SIGNER_PRIVATE_KEY=

# --- Identity -----------------------------------------------------------------
# Institution the staging stack is provisioned for (manifest + workers + engine,
# the Keycloak institution_id attribute claim and the membership row).
STAGING_INSTITUTION_ID=INST-CENTRAL-STAGING

# --- OIDC (H05: REAL provider — Keycloak, realm "burhan") ---------------------
# The realm/client topology is committed (infra/staging/keycloak/realm-burhan.json);
# only SECRETS and human-identity values live here. The compose defaults for the
# issuer/JWKS URLs are already correct for this stack:
#   issuer: http://127.0.0.1:18081/realms/burhan (browser-facing, loopback-only)
#   JWKS:   http://keycloak:8080/realms/burhan/protocol/openid-connect/certs (in-network)
# STAGING_OIDC_ISSUER=http://127.0.0.1:18081/realms/burhan
# STAGING_OIDC_JWKS_URL=http://keycloak:8080/realms/burhan/protocol/openid-connect/certs

# Keycloak bootstrap admin (created on the container's first start).
STAGING_KEYCLOAK_ADMIN_USERNAME=staging-admin
STAGING_KEYCLOAK_ADMIN_PASSWORD=

# Staging institutional operator (provisioned idempotently by the one-shot
# keycloak-provision-operator service together with its ACTIVE OPERATOR
# membership row). Used by the browser/E2E login flows.
STAGING_OIDC_USERNAME=staging-operator
STAGING_OIDC_USER_PASSWORD=
