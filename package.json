{
  "name": "cyber-audit-forensics-chain",
  "version": "2.0.0",
  "description": "Integrating Digital Forensics and Financial Accounting: A Cyber-Auditing System for Mitigating Insider Threat Fraud",
  "main": "hardhat.config.js",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:contracts": "hardhat test",
    "test:coverage": "hardhat coverage",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "node": "hardhat node",
    "clean": "hardhat clean",
    "demo:simulate": "hardhat run scripts/simulate-fraud-case.js",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "api:export": "node scripts/run-python.js scripts/export-openapi.py",
    "api:check": "node scripts/run-python.js scripts/check-openapi.py",
    "api:generate": "node scripts/run-python.js scripts/export-openapi.py",
    "contracts:export": "node scripts/export-contracts.js",
    "contracts:check": "node scripts/check-contracts.js",
    "deploy:verify": "node scripts/verify-deployment.js",
    "verify:contracts": "node scripts/check-contracts.js && hardhat test",
    "verify:api": "node --test shared/tests/evidence-hash.test.mjs shared/tests/currency.test.mjs && node scripts/run-python.js scripts/check-openapi.py && node scripts/run-python.js -m pytest -q ai-engine/tests",
    "verify:frontend": "npm --prefix frontend run lint && npm --prefix frontend test -- --run && npm --prefix frontend run build",
    "test:integration": "node scripts/run-integration.js",
    "test:load": "node tests/load/scenarios.js",
    "verify:integration": "node scripts/run-integration.js",
    "verify:all": "npm run verify:contracts && npm run verify:api && npm run verify:frontend && npm run verify:integration"
  },
  "keywords": [
    "digital-forensics",
    "financial-accounting",
    "cyber-auditing",
    "insider-threat",
    "fraud-mitigation",
    "blockchain",
    "smart-contracts",
    "solidity",
    "aml",
    "kyc",
    "iraq-cbi",
    "fatf-compliance",
    "fastapi",
    "artificial-intelligence"
  ],
  "author": "H0777",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@playwright/test": "^1.64.1",
    "hardhat": "^2.22.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.0",
    "dotenv": "^16.0.0"
  }
}
