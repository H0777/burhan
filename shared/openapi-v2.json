  "info": {
    "description": "Authoritative contract for institutional evidence verification, policy resolution, and lifecycle readiness.",
    "title": "Cyber-Forensic Auditing Framework - V2 API",
    "version": "2.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v2/evidence/verify": {
      "post": {
        "description": "Independently verifies an Evidence V2 payload against cryptographic hashing rules\nand on-chain anchor consensus.",
        "operationId": "verify_evidence_endpoint_api_v2_evidence_verify_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvidenceVerificationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidenceVerificationResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Verify evidence chain independently",
        "tags": [
          "Evidence V2"
        ]
      }
    },
    "/api/v2/health/live": {
      "get": {
        "description": "Confirms the process is running and able to handle HTTP traffic.",
        "operationId": "live_check_api_v2_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveHealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Process liveness check",
        "tags": [
          "Health V2"
        ]
      }
    },
    "/api/v2/health/ready": {
      "get": {
        "description": "Verifies that required internal subsystems (ML engine, policy service, schemas)\nare operational.",
        "operationId": "ready_check_api_v2_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyHealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Subsystem readiness check",
        "tags": [
          "Health V2"
        ]
      }
    },
    "/api/v2/policies/active": {
      "get": {
        "description": "Returns the authoritative active AML/KYC policy version and minor-unit thresholds\nfor the requested asset and institutional scope.",
        "operationId": "get_active_policy_endpoint_api_v2_policies_active_get",
        "parameters": [
          {
            "description": "Asset identifier (ETH, IQD)",
            "in": "query",
            "name": "asset",
            "required": false,
            "schema": {
              "default": "ETH",
              "description": "Asset identifier (ETH, IQD)",
              "title": "Asset",
              "type": "string"
            }
          },
          {
            "description": "Institution partition ID",
            "in": "query",
            "name": "institutionId",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Institution partition ID",
              "title": "Institutionid"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PolicyVersion"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get active compliance policy",
        "tags": [
          "Policies V2"
        ]
      }
    }
  }
}
