# .env.example — copy to .env for local (non-committed) overrides.
# The repository never commits real secret values.
#
# Staging environment (H04): the staging stack has its own template with the
# full variable list — see infra/staging/.env.example (copy to
# infra/staging/.env; it is gitignored).
#
# Frontend runtime configuration is NOT env-driven (R13): it is served at
# runtime via /runtime-config.json (frontend/public/runtime-config.json;
# the staging stack mounts infra/staging/runtime-config.staging.json).

# --- Staging stack variables (summary; full list in infra/staging/.env.example)
# STAGING_PG_SUPERUSER_PASSWORD=
# STAGING_MIGRATOR_PASSWORD=
# STAGING_APP_PASSWORD=
# STAGING_ANCHOR_SIGNER_PRIVATE_KEY=
# STAGING_INSTITUTION_ID=INST-CENTRAL-STAGING

# --- Demo compose (docker-compose.yml) ---------------------------------------
# GEMINI_API_KEY=
# RPC_PORT=8545
# AI_PORT=8005
# DB_PORT=5432
# FRONTEND_PORT=3005
